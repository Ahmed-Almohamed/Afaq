# PostgreSQL Connection (for Railway)
# Railway will automatically provide DATABASE_URL, but you can override it:
DATABASE_URL=postgresql://user:password@localhost:5432/afaq_analytics

# OR use individual connection variables (for local development):
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=afaq_analytics

# Node Environment
NODE_ENV=production
PORT=3000
